{
  "name": "formbuilder-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "表单构建器 Monorepo",
  "scripts": {
    "build": "pnpm -r build",
    "build:core": "pnpm --filter @formbuilder/core build",
    "build:ui": "pnpm --filter @formbuilder/ui build",
    "build:all": "pnpm -r --parallel build",
    "dev": "pnpm --filter @formbuilder/web dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean",
    "type-check": "pnpm -r type-check",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.26.2",
    "@rollup/plugin-commonjs": "^24.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "rollup": "^3.0.0",
    "rollup-plugin-dts": "^5.0.0",
    "rollup-plugin-postcss": "^4.0.2",
    "typescript": "^5.0.0"
  }
}
